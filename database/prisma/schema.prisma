// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  kind            UserKind
  status          UserStatus @default(ACTIVE)
  mobileE164      String?    @unique @map("mobile_e164") @db.VarChar(16)
  mobileVerifiedAt DateTime? @map("mobile_verified_at") @db.Timestamptz(3)
  email           String?    @unique @db.VarChar(200)
  passwordHash    String?    @map("password_hash")
  fullName        String?    @map("full_name") @db.VarChar(120)
  preferredLocale UiLocale   @default(fa) @map("preferred_locale")
  /// TOTP secret encrypted with the app key (AES-256-GCM); never returned by the API.
  mfaSecretEnc    String?    @map("mfa_secret_enc")
  mfaEnabledAt    DateTime?  @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time step; codes at or before it are rejected (replay protection).
  mfaLastTimeStep Int?       @map("mfa_last_time_step")
  /// Incremented on role change/suspension to invalidate live sessions and sockets.
  authVersion     Int        @default(0) @map("auth_version")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerProfile     CustomerProfile?
  addresses           Address[]
  sessions            Session[]
  roles               UserRole[]         @relation("UserRoles")
  rolesGranted        UserRole[]         @relation("RoleGrantedBy")
  recoveryCodes       MfaRecoveryCode[]
  mfaChallenges       MfaChallenge[]
  invitationsSent     StaffInvitation[]
  carts               Cart[]
  orders              Order[]
  sourcingRequests    SourcingRequest[]  @relation("RequestCustomer")
  assignedRequests    SourcingRequest[]  @relation("RequestAssignee")
  quotesAsCustomer    Quote[]
  quoteVersionsCreated QuoteVersion[]    @relation("QuoteVersionCreator")
  procurements        Procurement[]      @relation("ProcurementCustomer")
  assignedProcurements Procurement[]     @relation("ProcurementAssignee")
  paymentAttempts     PaymentAttempt[]
  conversationsAsCustomer Conversation[] @relation("ConversationCustomer")
  conversationsAssigned   Conversation[] @relation("ConversationAssignee")
  participations      Participant[]
  messages            Message[]
  readCursors         MessageReadCursor[]
  internalNotes       InternalNote[]
  attachments         Attachment[]
  importJobs          ImportJob[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  policyAcceptances   PolicyAcceptance[]
  returnRequests      ReturnRequest[]    @relation("ReturnCustomer")
  exchangeRates       ExchangeRate[]

  @@index([kind, status])
  @@map("user")
}

model CustomerProfile {
  userId           String              @id @map("user_id") @db.Uuid
  customerType     CustomerType        @default(CONSUMER) @map("customer_type")
  customerGroupId  String?             @map("customer_group_id") @db.Uuid
  groupStatus      GroupApprovalStatus @default(NONE) @map("group_status")
  requestedType    CustomerType?       @map("requested_type")
  businessName     String?             @map("business_name") @db.VarChar(200)
  businessCity     String?             @map("business_city") @db.VarChar(60)
  businessNote     String?             @map("business_note") @db.VarChar(1000)
  companyRole      String?             @map("company_role") @db.VarChar(100)
  groupDecidedById String?             @map("group_decided_by_id") @db.Uuid
  groupDecidedAt   DateTime?           @map("group_decided_at") @db.Timestamptz(3)
  groupDecisionNote String?            @map("group_decision_note") @db.VarChar(500)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  customerGroup CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)

  @@index([groupStatus])
  @@map("customer_profile")
}

model Address {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  label           String?   @db.VarChar(60)
  recipientName   String    @map("recipient_name") @db.VarChar(120)
  recipientMobile String    @map("recipient_mobile") @db.VarChar(16)
  province        String    @db.VarChar(60)
  city            String    @db.VarChar(60)
  addressLine     String    @map("address_line") @db.VarChar(400)
  postalCode      String    @map("postal_code") @db.VarChar(10)
  isDefault       Boolean   @default(false) @map("is_default")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("address")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  /// SHA-256 of the opaque cookie token; the token itself is never stored.
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Uuid
  kind          UserKind
  authVersion   Int       @map("auth_version")
  mfaVerified   Boolean   @default(false) @map("mfa_verified")
  userAgent     String?   @map("user_agent") @db.VarChar(200)
  ipHash        String?   @map("ip_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(60)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("session")
}

model OtpChallenge {
  id          String    @id @default(uuid(7)) @db.Uuid
  mobileE164  String    @map("mobile_e164") @db.VarChar(16)
  codeHash    String    @map("code_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(3)
  ipHash      String?   @map("ip_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mobileE164, createdAt])
  @@index([ipHash, createdAt])
  @@map("otp_challenge")
}

model MfaChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  purpose    String    @db.VarChar(30) // LOGIN | ENROLL
  pendingSecretEnc String? @map("pending_secret_enc")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("mfa_challenge")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("mfa_recovery_code")
}

model StaffInvitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  email       String    @db.VarChar(200)
  fullName    String    @map("full_name") @db.VarChar(120)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  roleIds     String[]  @map("role_ids") @db.Uuid
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@map("staff_invitation")
}

/// One-time bootstrap token for creating the first owner (CLI only).
model BootstrapToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("bootstrap_token")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(40)
  nameFa      String   @map("name_fa") @db.VarChar(80)
  nameEn      String   @map("name_en") @db.VarChar(80)
  isSystem    Boolean  @default(false) @map("is_system")
  isOwner     Boolean  @default(false) @map("is_owner")
  requiresMfa Boolean  @default(false) @map("requires_mfa")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("role")
}

model Permission {
  key         String @id @db.VarChar(60)
  description String @db.VarChar(200)

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key") @db.VarChar(60)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@map("role_permission")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model VehicleBrand {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique @db.VarChar(40)
  slug       String   @unique @db.VarChar(80)
  nameFa     String   @map("name_fa") @db.VarChar(80)
  nameEn     String?  @map("name_en") @db.VarChar(80)
  isFeatured Boolean  @default(false) @map("is_featured")
  sortOrder  Int      @default(0) @map("sort_order")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products             ProductVehicleBrand[]
  sourcingRequestItems SourcingRequestItem[]

  @@map("vehicle_brand")
}

model ManufacturerBrand {
  id             String   @id @default(uuid(7)) @db.Uuid
  slug           String   @unique @db.VarChar(80)
  nameFa         String   @map("name_fa") @db.VarChar(120)
  nameEn         String?  @map("name_en") @db.VarChar(120)
  /// normalizeSearchText(name) — prevents "Isaco"/"ایساکو" typos creating duplicates in imports.
  normalizedName String   @unique @map("normalized_name") @db.VarChar(120)
  countryCode    String?  @map("country_code") @db.Char(2)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@map("manufacturer_brand")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(40)
  slug      String   @unique @db.VarChar(80)
  parentId  String?  @map("parent_id") @db.Uuid
  nameFa    String   @map("name_fa") @db.VarChar(120)
  nameEn    String?  @map("name_en") @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("category")
}

model Product {
  id                   String            @id @default(uuid(7)) @db.Uuid
  sku                  String            @unique @db.VarChar(64)
  slug                 String            @unique @db.VarChar(120)
  categoryId           String            @map("category_id") @db.Uuid
  manufacturerBrandId  String?           @map("manufacturer_brand_id") @db.Uuid
  partType             PartType          @map("part_type")
  condition            PhysicalCondition
  origin               ProductOrigin
  countryOfManufacture String?           @map("country_of_manufacture") @db.Char(2)
  unit                 String            @default("عدد") @db.VarChar(30)
  packQuantity         Int               @default(1) @map("pack_quantity")
  oemCodes             String[]          @map("oem_codes")
  specs                Json              @default("[]")
  published            Boolean           @default(false)
  publishedAt          DateTime?         @map("published_at") @db.Timestamptz(3)
  isSellable           Boolean           @default(true) @map("is_sellable")
  /// Sold products are archived, never hard-deleted (order history stays intact).
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz(3)
  /// normalizeSearchText(fa + en + aliases + sku + oem codes)
  searchText           String            @default("") @map("search_text")
  searchCompact        String            @default("") @map("search_compact")
  version              Int               @default(0)
  createdById          String?           @map("created_by_id") @db.Uuid
  updatedById          String?           @map("updated_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  category          Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  manufacturerBrand ManufacturerBrand?    @relation(fields: [manufacturerBrandId], references: [id], onDelete: Restrict)
  translations      ProductTranslation[]
  vehicleBrands     ProductVehicleBrand[]
  media             ProductMedia[]
  fitments          ProductFitment[]
  basePrice         ProductPrice?
  priceRules        QuantityPriceRule[]
  inventory         InventoryBalance[]
  reservations      InventoryReservation[]
  movements         InventoryMovement[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([published, archivedAt, categoryId])
  @@index([origin])
  // Trigram indexes for Persian/English search (pg_trgm is created in the constraints migration).
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_search_text_trgm_idx")
  @@index([searchCompact(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_search_compact_trgm_idx")
  @@map("product")
}

model ProductTranslation {
  productId      String   @map("product_id") @db.Uuid
  locale         UiLocale
  name           String   @db.VarChar(200)
  description    String?
  technicalNotes String?  @map("technical_notes")
  warranty       String?  @db.VarChar(500)
  aliases        String[]

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
  @@map("product_translation")
}

model ProductVehicleBrand {
  productId      String @map("product_id") @db.Uuid
  vehicleBrandId String @map("vehicle_brand_id") @db.Uuid

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleBrand VehicleBrand @relation(fields: [vehicleBrandId], references: [id], onDelete: Restrict)

  @@id([productId, vehicleBrandId])
  @@index([vehicleBrandId])
  @@map("product_vehicle_brand")
}

model ProductMedia {
  id                 String    @id @default(uuid(7)) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  /// Key in the *public* product-media bucket (separate from private attachments).
  storageKey         String    @unique @map("storage_key") @db.VarChar(200)
  width              Int
  height             Int
  mime               String    @db.VarChar(40)
  sizeBytes          Int       @map("size_bytes")
  altFa              String    @map("alt_fa") @db.VarChar(200)
  altEn              String?   @map("alt_en") @db.VarChar(200)
  sortOrder          Int       @default(0) @map("sort_order")
  isPrimary          Boolean   @default(false) @map("is_primary")
  sourceAttachmentId String?   @map("source_attachment_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@map("product_media")
}

/// Manual, optional compatibility notes (v1). Not a catalog engine; see docs/FUTURE_CATALOG.md.
model ProductFitment {
  id             String  @id @default(uuid(7)) @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  vehicleBrandId String? @map("vehicle_brand_id") @db.Uuid
  modelText      String  @map("model_text") @db.VarChar(120)
  yearFrom       Int?    @map("year_from")
  yearTo         Int?    @map("year_to")
  note           String? @db.VarChar(300)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_fitment")
}

// ---------------------------------------------------------------------------
// Pricing
// ---------------------------------------------------------------------------

model CustomerGroup {
  id               String   @id @default(uuid(7)) @db.Uuid
  key              String   @unique @db.VarChar(40)
  nameFa           String   @map("name_fa") @db.VarChar(80)
  nameEn           String   @map("name_en") @db.VarChar(80)
  requiresApproval Boolean  @default(true) @map("requires_approval")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profiles   CustomerProfile[]
  priceRules QuantityPriceRule[]

  @@map("customer_group")
}

/// Public base price: exactly one per product, one base currency.
model ProductPrice {
  id              String       @id @default(uuid(7)) @db.Uuid
  productId       String       @unique @map("product_id") @db.Uuid
  baseCurrency    CurrencyCode @map("base_currency")
  baseAmountMinor BigInt       @map("base_amount_minor")
  manualIrrMinor  BigInt?      @map("manual_irr_minor")
  /// Display/reference only in v1 (payments settle in IRR).
  manualAedMinor  BigInt?      @map("manual_aed_minor")
  version         Int          @default(0)
  updatedById     String?      @map("updated_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("product_price")
}

/// Group and/or quantity tiers. customerGroupId = null means a public quantity tier.
model QuantityPriceRule {
  id              String       @id @default(uuid(7)) @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  customerGroupId String?      @map("customer_group_id") @db.Uuid
  minQty          Int          @map("min_qty")
  maxQty          Int?         @map("max_qty")
  baseCurrency    CurrencyCode @map("base_currency")
  baseAmountMinor BigInt       @map("base_amount_minor")
  manualIrrMinor  BigInt?      @map("manual_irr_minor")
  manualAedMinor  BigInt?      @map("manual_aed_minor")
  validFrom       DateTime?    @map("valid_from") @db.Timestamptz(3)
  validTo         DateTime?    @map("valid_to") @db.Timestamptz(3)
  active          Boolean      @default(true)
  createdById     String?      @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerGroup CustomerGroup? @relation(fields: [customerGroupId], references: [id], onDelete: Restrict)

  @@index([productId, customerGroupId, active])
  @@map("quantity_price_rule")
}

/// irr_per_aed = rials per one dirham. History is append-only; the current rate is
/// the latest row with effective_from <= now().
model ExchangeRate {
  id            String   @id @default(uuid(7)) @db.Uuid
  irrPerAed     Decimal  @map("irr_per_aed") @db.Decimal(24, 6)
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  note          String?  @db.VarChar(300)
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([effectiveFrom])
  @@map("exchange_rate")
}

// ---------------------------------------------------------------------------
// Inventory (single warehouse in v1; warehouse_id kept for growth)
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(40)
  name      String   @db.VarChar(120)
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  balances     InventoryBalance[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]

  @@map("warehouse")
}

model InventoryBalance {
  id                String   @id @default(uuid(7)) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  onHand            Int      @default(0) @map("on_hand")
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@map("inventory_balance")
}

model InventoryReservation {
  id            String            @id @default(uuid(7)) @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  warehouseId   String            @map("warehouse_id") @db.Uuid
  orderId       String            @map("order_id") @db.Uuid
  orderItemId   String            @map("order_item_id") @db.Uuid
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(3)
  releasedAt    DateTime?         @map("released_at") @db.Timestamptz(3)
  consumedAt    DateTime?         @map("consumed_at") @db.Timestamptz(3)
  releaseReason String?           @map("release_reason") @db.VarChar(60)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([orderId])
  @@map("inventory_reservation")
}

model InventoryMovement {
  id            String                @id @default(uuid(7)) @db.Uuid
  productId     String                @map("product_id") @db.Uuid
  warehouseId   String                @map("warehouse_id") @db.Uuid
  type          InventoryMovementType
  onHandDelta   Int                   @map("on_hand_delta")
  reservedDelta Int                   @map("reserved_delta")
  onHandAfter   Int                   @map("on_hand_after")
  reservedAfter Int                   @map("reserved_after")
  reason        String                @db.VarChar(60)
  note          String?               @db.VarChar(500)
  referenceType String?               @map("reference_type") @db.VarChar(40)
  referenceId   String?               @map("reference_id") @db.Uuid
  actorId       String?               @map("actor_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movement")
}

// ---------------------------------------------------------------------------
// Sales: cart, stock orders, shipping
// ---------------------------------------------------------------------------

model Cart {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String?   @unique @map("user_id") @db.Uuid
  guestTokenHash String?   @unique @map("guest_token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  items CartItem[]

  @@map("cart")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_item")
}

model ShippingMethod {
  id                  String   @id @default(uuid(7)) @db.Uuid
  code                String   @unique @db.VarChar(40)
  nameFa              String   @map("name_fa") @db.VarChar(120)
  nameEn              String?  @map("name_en") @db.VarChar(120)
  carrierCode         String?  @map("carrier_code") @db.VarChar(40)
  /// Only for a configured, known carrier. Must contain {code}.
  trackingUrlTemplate String?  @map("tracking_url_template") @db.VarChar(300)
  active              Boolean  @default(true)
  sortOrder           Int      @default(0) @map("sort_order")
  version             Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  zones     ShippingZone[]
  orders    Order[]
  shipments Shipment[]

  @@map("shipping_method")
}

model ShippingZone {
  id           String   @id @default(uuid(7)) @db.Uuid
  methodId     String   @map("method_id") @db.Uuid
  provinces    String[]
  /// NULL = cost unknown → checkout shows an inquiry path, never 0.
  costIrrMinor BigInt?  @map("cost_irr_minor")
  minDays      Int?     @map("min_days")
  maxDays      Int?     @map("max_days")

  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@index([methodId])
  @@map("shipping_zone")
}

model Order {
  id                  String               @id @default(uuid(7)) @db.Uuid
  reference           String               @unique @db.VarChar(20)
  userId              String               @map("user_id") @db.Uuid
  status              StockOrderStatus     @default(AWAITING_PAYMENT)
  paymentStatus       PaymentSummaryStatus @default(UNPAID) @map("payment_status")
  currency            CurrencyCode         @default(IRR)
  itemsTotalMinor     BigInt               @map("items_total_minor")
  discountMinor       BigInt               @default(0) @map("discount_minor")
  shippingMinor       BigInt               @map("shipping_minor")
  taxMinor            BigInt               @default(0) @map("tax_minor")
  grandTotalMinor     BigInt               @map("grand_total_minor")
  fxRateId            String?              @map("fx_rate_id") @db.Uuid
  irrPerAed           Decimal?             @map("irr_per_aed") @db.Decimal(24, 6)
  roundingRule        String               @map("rounding_rule") @db.VarChar(30)
  taxRuleSnapshot     Json?                @map("tax_rule_snapshot")
  pricingRulesVersion String               @map("pricing_rules_version") @db.VarChar(30)
  addressSnapshot     Json                 @map("address_snapshot")
  shippingMethodId    String               @map("shipping_method_id") @db.Uuid
  shippingSnapshot    Json                 @map("shipping_snapshot")
  policyVersionId     String               @map("policy_version_id") @db.Uuid
  customerNote        String?              @map("customer_note") @db.VarChar(1000)
  idempotencyKey      String               @map("idempotency_key") @db.VarChar(128)
  reservationExpiresAt DateTime?           @map("reservation_expires_at") @db.Timestamptz(3)
  version             Int                  @default(0)
  confirmedAt         DateTime?            @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod         @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  policyVersion  PolicyVersion          @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  reservations   InventoryReservation[]
  payments       PaymentAttempt[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("order")
}

model OrderItem {
  id               String            @id @default(uuid(7)) @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  productId        String            @map("product_id") @db.Uuid
  skuSnapshot      String            @map("sku_snapshot") @db.VarChar(64)
  nameFaSnapshot   String            @map("name_fa_snapshot") @db.VarChar(200)
  nameEnSnapshot   String?           @map("name_en_snapshot") @db.VarChar(200)
  partType         PartType          @map("part_type")
  condition        PhysicalCondition
  origin           ProductOrigin
  quantity         Int
  unitPriceMinor   BigInt            @map("unit_price_minor")
  lineTotalMinor   BigInt            @map("line_total_minor")
  /// Tier, payable source, reference AED, rate id and rounding used for this line.
  priceSnapshot    Json              @map("price_snapshot")
  returnedQuantity Int               @default(0) @map("returned_quantity")

  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  reservations InventoryReservation[]
  returnItems  ReturnRequestItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

/// Append-only state history for every business subject (actor, time, from/to, reason).
model OrderEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  subjectType EventSubject @map("subject_type")
  subjectId   String       @map("subject_id") @db.Uuid
  type        String       @db.VarChar(60)
  fromState   String?      @map("from_state") @db.VarChar(40)
  toState     String?      @map("to_state") @db.VarChar(40)
  reason      String?      @db.VarChar(1000)
  actorKind   ActorKind    @map("actor_kind")
  actorId     String?      @map("actor_id") @db.Uuid
  /// Visible to the customer timeline? Internal-only events are false.
  customerVisible Boolean  @default(true) @map("customer_visible")
  data        Json         @default("{}")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subjectType, subjectId, createdAt])
  @@map("order_event")
}

model Shipment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  orderId             String?        @map("order_id") @db.Uuid
  procurementId       String?        @map("procurement_id") @db.Uuid
  shippingMethodId    String         @map("shipping_method_id") @db.Uuid
  carrierCode         String?        @map("carrier_code") @db.VarChar(40)
  trackingCode        String?        @map("tracking_code") @db.VarChar(80)
  destinationSnapshot Json           @map("destination_snapshot")
  costIrrMinor        BigInt?        @map("cost_irr_minor")
  status              ShipmentStatus @default(PENDING)
  shippedAt           DateTime?      @map("shipped_at") @db.Timestamptz(3)
  deliveredAt         DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdById         String?        @map("created_by_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order          Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  procurement    Procurement?   @relation(fields: [procurementId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([procurementId])
  @@map("shipment")
}

// ---------------------------------------------------------------------------
// Sourcing, quotes, procurement
// ---------------------------------------------------------------------------

model SourcingRequest {
  id               String                @id @default(uuid(7)) @db.Uuid
  reference        String                @unique @db.VarChar(20)
  customerId       String                @map("customer_id") @db.Uuid
  title            String                @db.VarChar(200)
  note             String?               @db.VarChar(3000)
  urgency          Urgency               @default(NORMAL)
  status           SourcingRequestStatus @default(SUBMITTED)
  deliveryProvince String?               @map("delivery_province") @db.VarChar(80)
  deliveryCity     String?               @map("delivery_city") @db.VarChar(80)
  assigneeId       String?               @map("assignee_id") @db.Uuid
  clientRequestId  String                @map("client_request_id") @db.VarChar(64)
  version          Int                   @default(0)
  submittedAt      DateTime?             @map("submitted_at") @db.Timestamptz(3)
  closedAt         DateTime?             @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer User                  @relation("RequestCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignee User?                 @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  items    SourcingRequestItem[]
  quotes   Quote[]

  @@unique([customerId, clientRequestId])
  @@index([status, createdAt])
  @@index([assigneeId, status])
  @@map("sourcing_request")
}

model SourcingRequestItem {
  id               String             @id @default(uuid(7)) @db.Uuid
  requestId        String             @map("request_id") @db.Uuid
  partName         String             @map("part_name") @db.VarChar(200)
  quantity         Int
  vehicleBrandId   String?            @map("vehicle_brand_id") @db.Uuid
  /// Free-text brand for anything outside the managed brand list (A03).
  vehicleBrandText String?            @map("vehicle_brand_text") @db.VarChar(80)
  vehicleModel     String?            @map("vehicle_model") @db.VarChar(80)
  vehicleYear      Int?               @map("vehicle_year")
  partCode         String?            @map("part_code") @db.VarChar(64)
  vin              String?            @db.VarChar(17)
  preference       SourcingPreference @default(ANY)
  notes            String?            @db.VarChar(1000)
  sortOrder        Int                @default(0) @map("sort_order")

  request      SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  vehicleBrand VehicleBrand?   @relation(fields: [vehicleBrandId], references: [id], onDelete: Restrict)
  quoteItems   QuoteItem[]

  @@index([requestId])
  @@map("sourcing_request_item")
}

model Quote {
  id               String   @id @default(uuid(7)) @db.Uuid
  reference        String   @unique @db.VarChar(20)
  requestId        String   @map("request_id") @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  currentVersionId String?  @unique @map("current_version_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  request        SourcingRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  customer       User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currentVersion QuoteVersion?   @relation("CurrentQuoteVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions       QuoteVersion[]  @relation("QuoteVersions")

  @@index([requestId])
  @@map("quote")
}

model QuoteVersion {
  id                     String             @id @default(uuid(7)) @db.Uuid
  quoteId                String             @map("quote_id") @db.Uuid
  versionNumber          Int                @map("version_number")
  status                 QuoteVersionStatus @default(DRAFT)
  createdById            String             @map("created_by_id") @db.Uuid
  validityHours          Int                @default(24) @map("validity_hours")
  sentAt                 DateTime?          @map("sent_at") @db.Timestamptz(3)
  validUntil             DateTime?          @map("valid_until") @db.Timestamptz(3)
  acceptedAt             DateTime?          @map("accepted_at") @db.Timestamptz(3)
  acceptedById           String?            @map("accepted_by_id") @db.Uuid
  rejectedAt             DateTime?          @map("rejected_at") @db.Timestamptz(3)
  rejectReason           String?            @map("reject_reason") @db.VarChar(1000)
  supersededAt           DateTime?          @map("superseded_at") @db.Timestamptz(3)
  supersededByVersionId  String?            @map("superseded_by_version_id") @db.Uuid
  cancelledAt            DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelReason           String?            @map("cancel_reason") @db.VarChar(1000)
  fxRateId               String?            @map("fx_rate_id") @db.Uuid
  irrPerAed              Decimal?           @map("irr_per_aed") @db.Decimal(24, 6)
  roundingRule           String             @map("rounding_rule") @db.VarChar(30)
  taxSnapshot            Json?              @map("tax_snapshot")
  itemsIrrMinor          BigInt             @default(0) @map("items_irr_minor")
  costsIrrMinor          BigInt             @default(0) @map("costs_irr_minor")
  taxIrrMinor            BigInt             @default(0) @map("tax_irr_minor")
  totalPayableIrrMinor   BigInt             @default(0) @map("total_payable_irr_minor")
  referenceTotalAedMinor BigInt?            @map("reference_total_aed_minor")
  leadTimeWording        LeadTimeWording    @default(ESTIMATE) @map("lead_time_wording")
  leadTimeOrigin         String             @default("PAYMENT_VERIFIED") @map("lead_time_origin") @db.VarChar(30)
  businessCalendarId     String?            @map("business_calendar_id") @db.Uuid
  calendarSnapshot       Json?              @map("calendar_snapshot")
  shippingLeadTime       Json?              @map("shipping_lead_time")
  termsPolicyVersionId   String             @map("terms_policy_version_id") @db.Uuid
  customerNote           String?            @map("customer_note") @db.VarChar(2000)
  /// Persian (RTL) quote PDF.
  pdfAttachmentId        String?            @map("pdf_attachment_id") @db.Uuid
  /// English (LTR) quote PDF, rendered from the same version data.
  pdfEnAttachmentId      String?            @map("pdf_en_attachment_id") @db.Uuid
  /// SHA-256 of the customer-visible content; PDF and acceptance refer to it.
  contentHash            String?            @map("content_hash") @db.Char(64)
  version                Int                @default(0)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  quote         Quote          @relation("QuoteVersions", fields: [quoteId], references: [id], onDelete: Restrict)
  currentOf     Quote?         @relation("CurrentQuoteVersion")
  createdBy     User           @relation("QuoteVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  termsPolicy   PolicyVersion  @relation(fields: [termsPolicyVersionId], references: [id], onDelete: Restrict)
  items         QuoteItem[]
  costs         QuoteCost[]
  procurement   Procurement?

  @@unique([quoteId, versionNumber])
  @@index([status, validUntil])
  @@map("quote_version")
}

model QuoteItem {
  id                String                @id @default(uuid(7)) @db.Uuid
  quoteVersionId    String                @map("quote_version_id") @db.Uuid
  sourcingItemId    String?               @map("sourcing_item_id") @db.Uuid
  description       String                @db.VarChar(300)
  quantity          Int
  manufacturer      String?               @db.VarChar(120)
  partType          PartType              @map("part_type")
  condition         PhysicalCondition
  compatibility     CompatibilityStatus
  alternativeNote   String?               @map("alternative_note") @db.VarChar(500)
  availability      QuoteItemAvailability
  /// Customer explicitly included this item when accepting.
  included          Boolean               @default(true)
  unitPriceCurrency CurrencyCode          @map("unit_price_currency")
  unitPriceMinor    BigInt                @map("unit_price_minor")
  discountCurrency  CurrencyCode?         @map("discount_currency")
  discountMinor     BigInt?               @map("discount_minor")
  lineTotalIrrMinor BigInt?               @map("line_total_irr_minor")
  leadMin           Int                   @map("lead_min")
  leadMax           Int                   @map("lead_max")
  leadUnit          LeadTimeUnit          @map("lead_unit")
  leadDayKind       DayKind               @map("lead_day_kind")
  sortOrder         Int                   @default(0) @map("sort_order")

  quoteVersion    QuoteVersion            @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)
  sourcingItem    SourcingRequestItem?    @relation(fields: [sourcingItemId], references: [id], onDelete: Restrict)
  internalCost    QuoteItemInternalCost?
  procurementItem ProcurementItem?

  @@index([quoteVersionId])
  @@map("quote_item")
}

/// Supplier cost is kept in its own table so customer queries cannot select it by accident.
model QuoteItemInternalCost {
  quoteItemId String       @id @map("quote_item_id") @db.Uuid
  currency    CurrencyCode
  amountMinor BigInt       @map("amount_minor")
  supplierId  String?      @map("supplier_id") @db.Uuid

  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@map("quote_item_internal_cost")
}

model QuoteCost {
  id             String       @id @default(uuid(7)) @db.Uuid
  quoteVersionId String       @map("quote_version_id") @db.Uuid
  code           String       @db.VarChar(20)
  label          String       @db.VarChar(120)
  currency       CurrencyCode
  amountMinor    BigInt       @map("amount_minor")
  amountIrrMinor BigInt       @map("amount_irr_minor")

  quoteVersion QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)

  @@index([quoteVersionId])
  @@map("quote_cost")
}

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(200)
  country   String?  @db.Char(2)
  city      String?  @db.VarChar(80)
  contact   String?  @db.VarChar(300)
  notes     String?  @db.VarChar(2000)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  quoteCosts       QuoteItemInternalCost[]
  procurementItems ProcurementItem[]

  @@map("supplier")
}

model Procurement {
  id                    String            @id @default(uuid(7)) @db.Uuid
  reference             String            @unique @db.VarChar(20)
  /// One accepted quote version → at most one procurement order (idempotent acceptance).
  quoteVersionId        String            @unique @map("quote_version_id") @db.Uuid
  customerId            String            @map("customer_id") @db.Uuid
  status                ProcurementStatus @default(AWAITING_PAYMENT)
  paymentStatus         PaymentSummaryStatus @default(UNPAID) @map("payment_status")
  totalPayableIrrMinor  BigInt            @map("total_payable_irr_minor")
  paidAt                DateTime?         @map("paid_at") @db.Timestamptz(3)
  /// Original promise, set once at payment verification; never overwritten.
  promisedReadyAt       DateTime?         @map("promised_ready_at") @db.Timestamptz(3)
  currentReadyEstimate  DateTime?         @map("current_ready_estimate") @db.Timestamptz(3)
  promisedDeliveryAt    DateTime?         @map("promised_delivery_at") @db.Timestamptz(3)
  currentDeliveryEstimate DateTime?       @map("current_delivery_estimate") @db.Timestamptz(3)
  addressSnapshot       Json?             @map("address_snapshot")
  operationalOrigin     String?           @map("operational_origin") @db.VarChar(80)
  assigneeId            String?           @map("assignee_id") @db.Uuid
  version               Int               @default(0)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  quoteVersion   QuoteVersion              @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)
  customer       User                      @relation("ProcurementCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignee       User?                     @relation("ProcurementAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  items          ProcurementItem[]
  payments       PaymentAttempt[]
  shipments      Shipment[]
  dateChanges    ProcurementDateChange[]
  returnRequests ReturnRequest[]

  @@index([status, currentReadyEstimate])
  @@map("procurement")
}

model ProcurementItem {
  id               String                @id @default(uuid(7)) @db.Uuid
  procurementId    String                @map("procurement_id") @db.Uuid
  quoteItemId      String                @unique @map("quote_item_id") @db.Uuid
  description      String                @db.VarChar(300)
  quantity         Int
  status           ProcurementItemStatus @default(PENDING)
  supplierId       String?               @map("supplier_id") @db.Uuid
  supplierOrderRef String?               @map("supplier_order_ref") @db.VarChar(80)
  unitCostCurrency CurrencyCode?         @map("unit_cost_currency")
  unitCostMinor    BigInt?               @map("unit_cost_minor")
  internalNote     String?               @map("internal_note") @db.VarChar(1000)
  purchasedAt      DateTime?             @map("purchased_at") @db.Timestamptz(3)
  receivedAt       DateTime?             @map("received_at") @db.Timestamptz(3)

  procurement Procurement @relation(fields: [procurementId], references: [id], onDelete: Restrict)
  quoteItem   QuoteItem   @relation(fields: [quoteItemId], references: [id], onDelete: Restrict)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([procurementId])
  @@map("procurement_item")
}

model ProcurementDateChange {
  id               String    @id @default(uuid(7)) @db.Uuid
  procurementId    String    @map("procurement_id") @db.Uuid
  field            String    @db.VarChar(30) // READY | DELIVERY
  previousEstimate DateTime? @map("previous_estimate") @db.Timestamptz(3)
  newEstimate      DateTime  @map("new_estimate") @db.Timestamptz(3)
  reason           String    @db.VarChar(1000)
  actorId          String    @map("actor_id") @db.Uuid
  notifiedAt       DateTime? @map("notified_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  procurement Procurement @relation(fields: [procurementId], references: [id], onDelete: Restrict)

  @@index([procurementId])
  @@map("procurement_date_change")
}

model BusinessCalendar {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(80)
  timeZone    String   @default("Asia/Tehran") @map("time_zone") @db.VarChar(40)
  weekendDays Int[]    @map("weekend_days")
  holidays    String[]
  isDefault   Boolean  @default(false) @map("is_default")
  version     Int      @default(0)
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("business_calendar")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model PaymentAttempt {
  id                    String             @id @default(uuid(7)) @db.Uuid
  reference             String             @unique @db.VarChar(24)
  subjectType           PaymentSubjectType @map("subject_type")
  orderId               String?            @map("order_id") @db.Uuid
  procurementId         String?            @map("procurement_id") @db.Uuid
  customerId            String             @map("customer_id") @db.Uuid
  provider              String             @db.VarChar(40)
  merchantId            String             @map("merchant_id") @db.VarChar(80)
  providerReference     String?            @map("provider_reference") @db.VarChar(120)
  providerTransactionId String?            @map("provider_transaction_id") @db.VarChar(120)
  amountIrrMinor        BigInt             @map("amount_irr_minor")
  status                PaymentStatus      @default(CREATED)
  /// Exactly what the customer accepted when starting this session (amounts, rate, items, policy).
  snapshot              Json
  providerDeadline      DateTime?          @map("provider_deadline") @db.Timestamptz(3)
  redirectUrl           String?            @map("redirect_url") @db.VarChar(1000)
  /// Locale of the customer when the session started (for the return page).
  locale                UiLocale           @default(fa)
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  verifiedAmountIrrMinor BigInt?           @map("verified_amount_irr_minor")
  overpaymentIrrMinor   BigInt             @default(0) @map("overpayment_irr_minor")
  cardMask              String?            @map("card_mask") @db.VarChar(24)
  failureCode           String?            @map("failure_code") @db.VarChar(60)
  lastInquiryAt         DateTime?          @map("last_inquiry_at") @db.Timestamptz(3)
  inquiryCount          Int                @default(0) @map("inquiry_count")
  idempotencyKey        String             @map("idempotency_key") @db.VarChar(128)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  order       Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  procurement Procurement?       @relation(fields: [procurementId], references: [id], onDelete: Restrict)
  customer    User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  events      PaymentEvent[]
  refunds     Refund[]
  settlement  PaymentSettlement?

  @@unique([provider, merchantId, providerReference])
  @@unique([customerId, idempotencyKey])
  @@index([status, lastInquiryAt])
  @@index([orderId])
  @@index([procurementId])
  @@map("payment_attempt")
}

/// The single primary settlement per subject: the DB-level guarantee against
/// applying a payment twice (duplicate callbacks/clicks/refreshes, A09).
model PaymentSettlement {
  id               String             @id @default(uuid(7)) @db.Uuid
  subjectType      PaymentSubjectType @map("subject_type")
  subjectId        String             @map("subject_id") @db.Uuid
  paymentAttemptId String             @unique @map("payment_attempt_id") @db.Uuid
  amountIrrMinor   BigInt             @map("amount_irr_minor")
  settledAt        DateTime           @default(now()) @map("settled_at") @db.Timestamptz(3)

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@unique([subjectType, subjectId])
  @@map("payment_settlement")
}

/// Append-only (trigger-protected). Provider payloads are stored redacted.
model PaymentEvent {
  id               String   @id @default(uuid(7)) @db.Uuid
  paymentAttemptId String   @map("payment_attempt_id") @db.Uuid
  type             String   @db.VarChar(40)
  dedupeKey        String?  @unique @map("dedupe_key") @db.VarChar(200)
  data             Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([paymentAttemptId, createdAt])
  @@map("payment_event")
}

model Refund {
  id                      String       @id @default(uuid(7)) @db.Uuid
  reference               String       @unique @db.VarChar(24)
  paymentAttemptId        String       @map("payment_attempt_id") @db.Uuid
  amountIrrMinor          BigInt       @map("amount_irr_minor")
  status                  RefundStatus @default(REQUESTED)
  reason                  String       @db.VarChar(1000)
  returnRequestId         String?      @map("return_request_id") @db.Uuid
  resolutionCaseId        String?      @map("resolution_case_id") @db.Uuid
  requestedById           String?      @map("requested_by_id") @db.Uuid
  approvedById            String?      @map("approved_by_id") @db.Uuid
  processedById           String?      @map("processed_by_id") @db.Uuid
  providerRefundReference String?      @map("provider_refund_reference") @db.VarChar(120)
  /// Reference of a manual bank refund when the provider has no refund API.
  manualReference         String?      @map("manual_reference") @db.VarChar(120)
  providerResult          Json?        @map("provider_result")
  idempotencyKey          String       @unique @map("idempotency_key") @db.VarChar(128)
  version                 Int          @default(0)
  completedAt             DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  returnRequest  ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@index([paymentAttemptId, status])
  @@map("refund")
}

model ResolutionCase {
  id               String               @id @default(uuid(7)) @db.Uuid
  kind             ResolutionCaseKind
  status           ResolutionCaseStatus @default(OPEN)
  subjectType      PaymentSubjectType   @map("subject_type")
  subjectId        String               @map("subject_id") @db.Uuid
  paymentAttemptId String?              @map("payment_attempt_id") @db.Uuid
  amountIrrMinor   BigInt?              @map("amount_irr_minor")
  note             String?              @db.VarChar(2000)
  resolution       String?              @db.VarChar(2000)
  resolvedById     String?              @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([kind, paymentAttemptId])
  @@index([status, createdAt])
  @@map("resolution_case")
}

model IdempotencyRecord {
  id             String   @id @default(uuid(7)) @db.Uuid
  scope          String   @db.VarChar(60)
  actorKey       String   @map("actor_key") @db.VarChar(80)
  key            String   @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.Char(64)
  status         String   @default("IN_PROGRESS") @db.VarChar(20) // IN_PROGRESS | COMPLETED
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, actorKey, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}

// ---------------------------------------------------------------------------
// Conversations & files
// ---------------------------------------------------------------------------

model Conversation {
  id            String              @id @default(uuid(7)) @db.Uuid
  subjectKind   ConversationSubject @map("subject_kind")
  subjectId     String?             @map("subject_id") @db.Uuid
  subject       String              @db.VarChar(200)
  customerId    String              @map("customer_id") @db.Uuid
  assigneeId    String?             @map("assignee_id") @db.Uuid
  closedAt      DateTime?           @map("closed_at") @db.Timestamptz(3)
  lastMessageAt DateTime?           @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  customer     User                @relation("ConversationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  assignee     User?               @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  participants Participant[]
  messages     Message[]
  readCursors  MessageReadCursor[]
  notes        InternalNote[]

  @@unique([subjectKind, subjectId])
  @@index([customerId, lastMessageAt])
  @@index([assigneeId, lastMessageAt])
  @@map("conversation")
}

model Participant {
  conversationId String          @map("conversation_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  role           ParticipantRole
  joinedAt       DateTime        @default(now()) @map("joined_at") @db.Timestamptz(3)
  removedAt      DateTime?       @map("removed_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("participant")
}

model Message {
  id              String     @id @default(uuid(7)) @db.Uuid
  conversationId  String     @map("conversation_id") @db.Uuid
  senderId        String?    @map("sender_id") @db.Uuid
  senderKind      SenderKind @map("sender_kind")
  clientMessageId String     @map("client_message_id") @db.VarChar(64)
  body            String     @default("") @db.VarChar(4000)
  quoteVersionId  String?    @map("quote_version_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User?               @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments  MessageAttachment[]

  /// Dedupe for retries after reconnect (A16). System messages use a namespaced id.
  @@unique([conversationId, senderKind, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@map("message")
}

model MessageAttachment {
  messageId    String @map("message_id") @db.Uuid
  attachmentId String @unique @map("attachment_id") @db.Uuid

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Restrict)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@id([messageId, attachmentId])
  @@map("message_attachment")
}

model MessageReadCursor {
  conversationId    String   @map("conversation_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  lastReadMessageId String   @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime @map("last_read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([conversationId, userId])
  @@map("message_read_cursor")
}

/// Staff-only notes. Never selected by customer-facing queries, PDFs or exports.
model InternalNote {
  id             String        @id @default(uuid(7)) @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  subjectType    EventSubject  @map("subject_type")
  subjectId      String        @map("subject_id") @db.Uuid
  authorId       String        @map("author_id") @db.Uuid
  body           String        @db.VarChar(4000)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([subjectType, subjectId])
  @@map("internal_note")
}

model Attachment {
  id               String               @id @default(uuid(7)) @db.Uuid
  ownerId          String               @map("owner_id") @db.Uuid
  purpose          AttachmentPurpose
  visibility       AttachmentVisibility @default(PRIVATE)
  status           AttachmentStatus     @default(UPLOADING)
  /// Random, unguessable key in the private bucket; never derived from the filename.
  storageKey       String               @unique @map("storage_key") @db.VarChar(200)
  originalFilename String               @map("original_filename") @db.VarChar(160)
  extension        String               @db.VarChar(10)
  detectedMime     String?              @map("detected_mime") @db.VarChar(120)
  sizeBytes        Int                  @map("size_bytes")
  sha256           String?              @db.Char(64)
  rejectReason     String?              @map("reject_reason") @db.VarChar(60)
  legacyOffice     Boolean              @default(false) @map("legacy_office")
  scanEngine       String?              @map("scan_engine") @db.VarChar(60)
  scannedAt        DateTime?            @map("scanned_at") @db.Timestamptz(3)
  subjectType      String?              @map("subject_type") @db.VarChar(40)
  subjectId        String?              @map("subject_id") @db.Uuid
  retentionUntil   DateTime?            @map("retention_until") @db.Timestamptz(3)
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  messageRef MessageAttachment?

  @@index([ownerId, createdAt])
  @@index([subjectType, subjectId])
  @@index([status])
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model ImportJob {
  id                      String          @id @default(uuid(7)) @db.Uuid
  kind                    String          @default("PRODUCTS") @db.VarChar(20)
  attachmentId            String          @map("attachment_id") @db.Uuid
  uploaderId              String          @map("uploader_id") @db.Uuid
  mode                    ImportMode
  fileChecksum            String          @map("file_checksum") @db.Char(64)
  idempotencyKey          String          @unique @map("idempotency_key") @db.VarChar(128)
  status                  ImportJobStatus @default(QUEUED)
  mapping                 Json            @default("{}")
  options                 Json            @default("{}")
  summary                 Json?
  planChecksum            String?         @map("plan_checksum") @db.Char(64)
  progress                Int             @default(0)
  totalRows               Int?            @map("total_rows")
  failureReason           String?         @map("failure_reason") @db.VarChar(500)
  errorReportAttachmentId String?         @map("error_report_attachment_id") @db.Uuid
  committedById           String?         @map("committed_by_id") @db.Uuid
  committedAt             DateTime?       @map("committed_at") @db.Timestamptz(3)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploader User        @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  rows     ImportRow[]

  @@index([status, createdAt])
  @@map("import_job")
}

/// Staging rows: preview is written here, commit applies them atomically.
model ImportRow {
  id                       String          @id @default(uuid(7)) @db.Uuid
  jobId                    String          @map("job_id") @db.Uuid
  rowNumber                Int             @map("row_number")
  sku                      String?         @db.VarChar(64)
  action                   ImportRowAction
  issues                   Json            @default("[]")
  values                   Json?
  changes                  Json            @default("[]")
  expectedProductVersion   Int?            @map("expected_product_version")
  expectedInventoryVersion Int?            @map("expected_inventory_version")
  productId                String?         @map("product_id") @db.Uuid
  appliedAt                DateTime?       @map("applied_at") @db.Timestamptz(3)

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@map("import_row")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(60)
  params    Json      @default("{}")
  linkPath  String?   @map("link_path") @db.VarChar(300)
  /// Prevents duplicate notifications for duplicate callbacks/events.
  dedupeKey String    @unique @map("dedupe_key") @db.VarChar(200)
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

model NotificationDelivery {
  id                String              @id @default(uuid(7)) @db.Uuid
  notificationId    String              @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error") @db.VarChar(500)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(120)
  nextAttemptAt     DateTime?           @map("next_attempt_at") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_delivery")
}

/// Transactional outbox: written in the same transaction as the business change,
/// dispatched by the worker so notifications/processes are never lost after commit.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          String       @db.VarChar(60)
  aggregateType String       @map("aggregate_type") @db.VarChar(40)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json
  dedupeKey     String       @unique @map("dedupe_key") @db.VarChar(200)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz(3)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error") @db.VarChar(1000)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_event")
}

/// Append-only (trigger-protected) audit trail of sensitive changes.
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  actorKind  ActorKind @map("actor_kind")
  action     String    @db.VarChar(80)
  entityType String    @map("entity_type") @db.VarChar(60)
  entityId   String?   @map("entity_id") @db.VarChar(80)
  before     Json?
  after      Json?
  requestId  String?   @map("request_id") @db.VarChar(64)
  ipHash     String?   @map("ip_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

model SiteSetting {
  key         String   @id @db.VarChar(60)
  value       Json
  version     Int      @default(0)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_setting")
}

model PolicyVersion {
  id          String       @id @default(uuid(7)) @db.Uuid
  kind        PolicyKind
  version     Int
  status      PolicyStatus @default(DRAFT)
  titleFa     String       @map("title_fa") @db.VarChar(200)
  titleEn     String?      @map("title_en") @db.VarChar(200)
  bodyFa      String       @map("body_fa")
  bodyEn      String?      @map("body_en")
  contentHash String       @map("content_hash") @db.Char(64)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  acceptances   PolicyAcceptance[]
  orders        Order[]
  quoteVersions QuoteVersion[]

  @@unique([kind, version])
  @@map("policy_version")
}

model PolicyAcceptance {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  policyVersionId String   @map("policy_version_id") @db.Uuid
  subjectType     String   @map("subject_type") @db.VarChar(40)
  subjectId       String   @map("subject_id") @db.Uuid
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@unique([policyVersionId, subjectType, subjectId])
  @@map("policy_acceptance")
}

model ReturnRequest {
  id             String              @id @default(uuid(7)) @db.Uuid
  reference      String              @unique @db.VarChar(24)
  customerId     String              @map("customer_id") @db.Uuid
  orderId        String?             @map("order_id") @db.Uuid
  procurementId  String?             @map("procurement_id") @db.Uuid
  kind           ReturnKind
  status         ReturnRequestStatus @default(REQUESTED)
  reason         String              @db.VarChar(1000)
  decisionReason String?             @map("decision_reason") @db.VarChar(1000)
  decidedById    String?             @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?           @map("decided_at") @db.Timestamptz(3)
  version        Int                 @default(0)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer    User                @relation("ReturnCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  procurement Procurement?        @relation(fields: [procurementId], references: [id], onDelete: Restrict)
  items       ReturnRequestItem[]
  refunds     Refund[]

  @@index([status, createdAt])
  @@index([customerId])
  @@map("return_request")
}

model ReturnRequestItem {
  id                String  @id @default(uuid(7)) @db.Uuid
  returnRequestId   String  @map("return_request_id") @db.Uuid
  orderItemId       String  @map("order_item_id") @db.Uuid
  quantity          Int
  receivedQuantity  Int     @default(0) @map("received_quantity")
  restockedQuantity Int     @default(0) @map("restocked_quantity")
  inspectionNote    String? @map("inspection_note") @db.VarChar(1000)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([returnRequestId])
  @@map("return_request_item")
}
