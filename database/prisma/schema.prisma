// HEDAX data model (spec §16).
// Conventions: UUIDv7 primary keys, snake_case tables/columns, UTC timestamptz,
// money as BigInt minor units (IRR = rial, AED = fils) with an explicit currency,
// `version` columns for optimistic locking. Constraints Prisma cannot express
// (CHECKs, partial unique indexes, trigram indexes, append-only triggers) live in
// migrations/*_constraints_search/migration.sql.

generator client {
  provider               = "prisma-client"
  output                 = "../../apps/api/src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

