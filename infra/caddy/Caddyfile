# HEDAX reverse proxy (Caddy 2): automatic HTTPS for {$HEDAX_DOMAIN}.
# Production S3 media routing verified on sourcebyhedax.ir on 2026-10-14.
# This production configuration expects the existing public media bucket (products/ and content/ readable).
#
#   /api/*    → NestJS API (REST, uploads, payment callbacks, chat WebSocket at /api/v1/ws)
#   /media/*  → public S3 images (products/ product photos, content/ site-content images);
#               every other prefix and the private bucket stay private (authenticated API routes).
#   else      → Next.js web (storefront + admin)
# /health/* is intentionally not routed: probes run inside the Docker network.

{
	email {$ACME_EMAIL}
}

{$HEDAX_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		# Upload limits are enforced by the API (≤20 MB per file, ≤50 MB per batch); this is a ceiling.
		request_body {
			max_size 60MB
		}
		reverse_proxy api:4000
	}

	handle_path /media/* {
		reverse_proxy https://sourcebyhedax-media.s3.ir-central1.arvanstorage.ir {
			header_up Host sourcebyhedax-media.s3.ir-central1.arvanstorage.ir
			header_up -Cookie
			header_up -Authorization
			header_up -Referer
			header_up -X-Forwarded-*
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Access log without request bodies or cookies.
	log {
		output stdout
		format json
	}
}

# The www alias needs its own DNS record and valid certificate.
www.{$HEDAX_DOMAIN} {
	redir https://{$HEDAX_DOMAIN}{uri} permanent
}
