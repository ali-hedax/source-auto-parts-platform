# HEDAX reverse proxy (Caddy 2): automatic HTTPS for {$HEDAX_DOMAIN}.
# Production S3 media routing verified on sourcebyhedax.ir on 2026-10-14.
# This production configuration expects the existing public media bucket (products/ and content/ readable).
#
#   /api/*    → NestJS API (REST, uploads, payment callbacks, chat WebSocket at /api/v1/ws)
#   /media/*  → public S3 images (products/ product photos, content/ site-content images);
#               every other prefix and the private bucket stay private (authenticated API routes).
#   /_next/static/* → built files on disk (precompressed), else the web app
#   else      → Next.js web (storefront + admin); guest public pages get a CDN cache header
# /health/* is intentionally not routed: probes run inside the Docker network.

{
	email {$ACME_EMAIL}
	# Error logs also include request metadata when an upstream is unavailable.
	log default {
		format filter {
			request>uri regexp /api/v1/integrations/.* /api/v1/integrations/REDACTED
			request>headers>X-Telegram-Bot-Api-Secret-Token delete
			wrap json
		}
	}
}

{$HEDAX_DOMAIN} {
	encode zstd gzip
	# Webhook headers and Bale capability URLs must never enter access logs.
	log_skip /api/v1/integrations/*

	# Brand database import (panel → «ورود دیتابیس برند»): one file up to 150 MB, streamed to disk by the API.
	handle /api/v1/admin/brand-imports/upload {
		request_body {
			max_size 160MB
		}
		reverse_proxy api:4000
	}

	handle /api/* {
		# Upload limits are enforced by the API (≤20 MB per file, ≤50 MB per batch); this is a ceiling.
		request_body {
			max_size 60MB
		}
		reverse_proxy api:4000
	}

	handle_path /media/* {
		reverse_proxy https://sourcebyhedax-media.s3.ir-central1.arvanstorage.ir {
			header_up Host sourcebyhedax-media.s3.ir-central1.arvanstorage.ir
			header_up -Cookie
			header_up -Authorization
			header_up -Referer
			header_up -X-Forwarded-*
		}
	}

	# Content-hashed JS, CSS and fonts: served from the copy each release puts on disk, with the brotli
	# and gzip files made when the web image was built (infra/docker/precompress.mjs). Older releases'
	# files stay there, so a page opened before a release still loads; a file not on disk (yet) is
	# still served by the web app.
	@builtAsset {
		path /_next/static/*
		file {
			root /srv/web-static
		}
	}
	handle @builtAsset {
		root * /srv/web-static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br gzip
		}
	}

	# Guest copies of the public pages may be kept by a CDN for two minutes (s-maxage) and are purged by
	# the API after every price, stock or content change (PublicCacheService); browsers always ask again
	# (max-age=0). A signed-in visitor, a chosen currency and Next's in-page (RSC) requests are never
	# shared, and the language cookie is not set on a shareable response.
	@guestPage {
		method GET HEAD
		path_regexp ^/(fa|en)(/(parts|imported-parts|brands|cars|help|pages)(/[^/]+)*|/(about|contact|terms|privacy|request-part))?/?$
		not header Cookie *hedax_sid=*
		not header Cookie *hedax_currency=*
		not header RSC *
		not query _rsc=*
	}
	header @guestPage {
		Cache-Control "public, max-age=0, s-maxage=120"
		-Set-Cookie
		defer
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Access log without request bodies or cookies.
	log {
		output stdout
		format json
	}
}

# The www alias needs its own DNS record and valid certificate.
www.{$HEDAX_DOMAIN} {
	redir https://{$HEDAX_DOMAIN}{uri} permanent
}
