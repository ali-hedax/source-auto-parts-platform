# Preview-only Docker Compose environment template.
# Copy this file outside the repository into a protected location. Fill every
# blank with values created specifically for Preview; never copy Production's
# .env, database URL, Redis URL, storage, backups, or secrets.

HEDAX_DOMAIN=preview.sourcebyhedax.ir
ACME_EMAIL=

# Create new Preview-only credentials and application secrets in the protected
# environment. Do not put values in this template or commit the copied file.
POSTGRES_PASSWORD=
REVALIDATE_SECRET=
SESSION_SECRET=
OTP_PEPPER=
APP_ENCRYPTION_KEY=

# Caddy basic_auth requires a username and a password hash. Keep both only in
# the protected environment; do not use a Production account or credential.
PREVIEW_BASIC_AUTH_USER=
PREVIEW_BASIC_AUTH_HASH=

# Explicitly Preview-only endpoints and behavior. The compose overlay enforces
# the safe provider and local-storage values even if this file is edited.
APP_ENV=staging
PUBLIC_BASE_URL=https://preview.sourcebyhedax.ir
LOG_LEVEL=info
PAYMENT_PROVIDER=none
SMS_PROVIDER=none
MAIL_PROVIDER=none
STORAGE_DRIVER=local
PUBLIC_MEDIA_BASE_URL=/media

# Leave all S3, SMTP and messenger variables absent. Do not set BACKUP_HOST_DIR
# or enable the backup profile with a Production destination.
