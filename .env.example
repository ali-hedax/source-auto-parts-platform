# HEDAX environment template. Copy to .env for local development.
# Only names and harmless examples live here; never commit real secrets.

# --- Runtime -----------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
PORT=4000
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=
TRUST_PROXY=false
LOG_LEVEL=info
OPENAPI_ENABLED=true                # must be false in production
COOKIE_SECURE=false                 # must be true in production (https)

# --- Data stores ---------------------------------------------------------------
DATABASE_URL=postgresql://hedax:change-me@localhost:5432/hedax?schema=public
REDIS_URL=redis://localhost:6379
# bullmq (default, required in production) | inline = development without Redis:
# the worker runs jobs (file scan, Excel, quote PDF, notifications) in its own process.
QUEUE_DRIVER=bullmq
# Public page cache purge: the API calls the web app after catalog/price/stock/policy
# changes. Same random secret for API, worker and web; empty = pages refresh on a timer.
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=

# --- Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET=
OTP_PEPPER=
APP_ENCRYPTION_KEY=

# --- Files -----------------------------------------------------------------------
STORAGE_DRIVER=local                # local | s3
LOCAL_STORAGE_DIR=./storage
PUBLIC_MEDIA_BASE_URL=/media
S3_ENDPOINT=
S3_REGION=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MALWARE_SCANNER=none-dev            # clamav in staging/production
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Integrations (not chosen yet; simulators are refused in production) ---------
PAYMENT_PROVIDER=simulator          # simulator (dev only) | none
PAYMENT_MERCHANT_ID=SIMULATOR
PAYMENT_SESSION_MINUTES=15
SMS_PROVIDER=dev-log                # dev-log (dev only) | none

# --- Web (Next.js) ---------------------------------------------------------------
# Server-side URL the web app uses to reach the API (not exposed to the browser).
API_INTERNAL_URL=http://localhost:4000/api/v1
# fixtures = labelled sample data for UI preview without a backend (development only)
HEDAX_DATA_SOURCE=api
# Live chat transport for the browser: off (polling) | same-origin (behind the reverse proxy) | http://localhost:4000 (local dev)
NEXT_PUBLIC_WS_URL=off

# --- Docker Compose deployment (infra/docker-compose.yml) -------------------------
HEDAX_DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
