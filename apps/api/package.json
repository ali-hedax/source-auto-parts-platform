{
  "name": "@hedax/api",
  "version": "0.1.0",
  "private": true,
  "description": "HEDAX REST API, WebSocket gateway and background job definitions",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "seed:dev": "node --env-file-if-exists=../../.env dist/database/seed-dev.js",
    "seed:base": "node --env-file-if-exists=../../.env dist/database/seed-base.js",
    "owner:bootstrap": "node --env-file-if-exists=../../.env dist/cli/bootstrap-owner.js",
    "openapi:export": "node --env-file-if-exists=../../.env dist/cli/export-openapi.js",
    "db:local": "node scripts/local-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/s3-request-presigner": "3.1143.0",
    "@hedax/contracts": "workspace:*",
    "@hedax/domain": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/websockets": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.10",
    "cookie": "2.0.1",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "multer": "2.4.0",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.4",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  },
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    }
  }
}
